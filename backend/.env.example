# AURA Backend — Environment Variables Example
# Copy this to .env and fill in your credentials.
# NEVER commit .env with real credentials to Git.

# ============================================================
# SERVER
# ============================================================
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ============================================================
# DATABASE
# ============================================================
# SQLite (default for development):
DATABASE_URL="file:./dev.db"

# PostgreSQL (for production — update schema.prisma provider to "postgresql"):
# DATABASE_URL="postgresql://user:password@localhost:5432/aura_db"

# ============================================================
# JWT SECRETS (use long random strings in production)
# ============================================================
JWT_ACCESS_SECRET=replace_with_secure_random_string_64_chars
JWT_REFRESH_SECRET=replace_with_different_secure_random_string_64_chars

# ============================================================
# AI PROVIDERS (backend-only — never expose to frontend)
# Set AI_PROVIDER to activate: gemini | openai | ollama
# ============================================================
AI_PROVIDER=gemini

# Google Gemini (default)
GEMINI_API_KEY=

# OpenAI-compatible API (OpenAI, LM Studio, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============================================================
# STORAGE PROVIDER
# Set STORAGE_PROVIDER to activate: local | s3
# ============================================================
STORAGE_PROVIDER=local

# AWS S3-compatible (activate with STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_AUDIO=aura-audio
S3_BUCKET_ARTWORK=aura-artwork
