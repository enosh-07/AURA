# AURA Environment Configuration
# =================================
# Copy this file to .env and fill in your values.
# Never commit .env with real secrets to version control.

# ---------------------------------------------------------------------------
# API Configuration
# ---------------------------------------------------------------------------

# Backend API base URL
# Development: http://localhost:4000/api/v1
# Production:  https://api.aura.example.com/api/v1
# Mobile:      Must be HTTPS (not localhost) when testing on a real device
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------

# Your Google OAuth 2.0 Client ID from Google Cloud Console.
# Required for Google Sign-In on web and desktop.
# Mobile uses the native Google Sign-In which reads from google-services.json (Android)
# and GoogleService-Info.plist (iOS).
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Deep Links & Universal Links
# ---------------------------------------------------------------------------

# The domain used for HTTPS universal links.
# Web fallback: https://<DOMAIN>/track/123
# Native apps open directly via aura://track/123
# Set this to your actual production domain before publishing.
VITE_DEEP_LINK_DOMAIN=aura.example.com

# ---------------------------------------------------------------------------
# App Version
# ---------------------------------------------------------------------------

VITE_APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------

# Enable/disable the AI companion feature
VITE_ENABLE_AI_COMPANION=true

# Enable/disable social rooms
VITE_ENABLE_SOCIAL_ROOMS=true
