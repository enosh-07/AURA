# AURA Production Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Base URL for API requests (Frontend & Mobile)
# Development: http://localhost:4000/api/v1
# Production:  https://api.aura.audio/api/v1 or https://aura.audio/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Deep Links & Universal Links domain
VITE_DEEP_LINK_DOMAIN=aura.audio
VITE_APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 2. SUPABASE (PostgreSQL, Auth, RLS, Realtime)
# ------------------------------------------------------------------------------
# Get your project URL and keys from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Safe for browser / client-side usage, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY — NEVER EXPOSE TO CLIENT)
# Bypasses Row Level Security for admin tasks and backend jobs
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection URL (for Prisma or direct migrations)
# Transaction pooler (Port 6543) or Session pooler (Port 5432)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 (S3-Compatible Lossless Media & Artwork Storage)
# ------------------------------------------------------------------------------
# Get credentials from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# Storage provider selection: local | r2 | s3
STORAGE_PROVIDER=local

# Cloudflare Account ID & S3 Endpoint
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
S3_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Access Keys (SERVER-ONLY — NEVER EXPOSE TO CLIENT)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_REGION=auto

# Buckets
R2_BUCKET_AUDIO=aura-audio
R2_BUCKET_ARTWORK=aura-artwork
S3_BUCKET_AUDIO=aura-audio
S3_BUCKET_ARTWORK=aura-artwork

# Public or Custom CDN Domain for high-performance audio delivery
# e.g., https://media.aura.audio
R2_PUBLIC_DOMAIN=https://media.aura.audio

# ------------------------------------------------------------------------------
# 4. RESEND (Transactional & Authentication Emails)
# ------------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
# SERVER-ONLY — NEVER EXPOSE TO CLIENT
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="AURA Music <notifications@aura.audio>"
RESEND_SUPPORT_EMAIL="support@aura.audio"

# ------------------------------------------------------------------------------
# 5. AI MUSIC INTELLIGENCE PROVIDERS
# ------------------------------------------------------------------------------
# Provider selection: gemini | openai | ollama
AI_PROVIDER=gemini

# Google Gemini (Default for AI Companion, Music Discovery & DJ sequencing)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenAI-Compatible API (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (Optional for offline/local AI execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & LEGACY JWT (Fallbacks)
# ------------------------------------------------------------------------------
# Google OAuth Client ID for Web / Native
# Get yours from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# JWT Secrets for legacy token validation
JWT_ACCESS_SECRET=replace_with_secure_random_string_64_chars
JWT_REFRESH_SECRET=replace_with_different_secure_random_string_64_chars

# ------------------------------------------------------------------------------
# 7. FEATURE FLAGS
# ------------------------------------------------------------------------------
VITE_ENABLE_AI_COMPANION=true
VITE_ENABLE_SOCIAL_ROOMS=true
VITE_ENABLE_LOSSLESS_STREAMING=true
